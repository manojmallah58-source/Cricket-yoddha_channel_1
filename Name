7. Program

import time
import serial
import RPi.GPIO as GPIO

from mfrc522 import SimpleMFRC522
from adafruit_fingerprint import Adafruit_Fingerprint

RELAY = 17

# Replace with the actual authorized RFID card ID.
AUTHORIZED_CARD_ID = 123456789

GPIO.setmode(GPIO.BCM)
GPIO.setup(RELAY, GPIO.OUT)
GPIO.output(RELAY, GPIO.LOW)

rfid = SimpleMFRC522()

uart = serial.Serial(
    "/dev/serial0",
    baudrate=57600,
    timeout=1
)

